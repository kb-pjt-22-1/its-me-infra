# 이 파일을 복사해서 .env로 저장한 뒤 값을 채우세요 (.env는 git에 안 올라갑니다).
#   cp .env.example .env

# ---- Docker image tag ----
# 로컬/dev에서는 보통 dev 이미지를 pull합니다. 운영 배포 시에는
# main-<sha> 값으로 덮어써서 실행합니다.
IMAGE_TAG=dev
FRONTEND_IMAGE_TAG=dev

# ---- MySQL ----
MYSQL_DATABASE=benepay
MYSQL_USER=benepay
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme

# ---- nginx + Let's Encrypt (운영 전용, --profile local에서는 안 씀) ----
CERTBOT_EMAIL=

# ---- App secrets (its-me-backend 컨테이너가 env_file로 읽음) ----
JWT_SECRET=local-dev-jwt-secret-change-this
PORTONE_IMP_KEY=
PORTONE_IMP_SECRET=
DI_HASH_SALT=local-dev-di-hash-salt-change-this
